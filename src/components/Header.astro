---
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import { business, phoneHref } from '../data/business';
import { navigation } from '../data/navigation';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

const isActive = (href: string) => {
	const target = href.replace(/\/+$/, '') || '/';
	return target === '/' ? currentPath === '/' : currentPath === target || currentPath.startsWith(`${target}/`);
};
---

<header class="site-header">
	<div class="topbar">
		<div class="container topbar__inner">
			<p class="topbar__item">
				<Icon name="clock" size={15} />
				<span>{business.hours.short}</span>
			</p>
			<a class="topbar__item topbar__phone" href={phoneHref}>
				<Icon name="phone" size={15} />
				<span>{business.phone.display}</span>
			</a>
		</div>
	</div>

	<div class="header__main">
		<div class="container header__inner">
			<a class="brand" href="/" aria-label={`${business.name}, ir a la página de inicio`}>
				<BrandMark size={46} />
				<span class="brand__copy">
					<span class="brand__name">{business.name}</span>
					<span class="brand__tagline">Ciber · Locutorio · Tienda</span>
				</span>
			</a>

			<nav class="nav" aria-label="Navegación principal">
				<ul class="nav__list">
					{navigation.map((item) => (
						<li>
							<a
								class="nav__link"
								href={item.href}
								aria-current={isActive(item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						</li>
					))}
				</ul>
			</nav>

			<a class="header__call button button--primary" href={phoneHref}>
				<Icon name="phone" size={18} />
				Llamar
			</a>

			<details class="mobile-menu">
				<summary class="mobile-menu__summary">
					<Icon name="menu" size={20} />
					<span>Menú</span>
				</summary>
				<nav class="mobile-menu__panel" aria-label="Navegación móvil">
					<ul class="mobile-menu__list">
						{navigation.map((item) => (
							<li>
								<a
									class="mobile-menu__link"
									href={item.href}
									aria-current={isActive(item.href) ? 'page' : undefined}
								>
									{item.label}
								</a>
							</li>
						))}
					</ul>
					<a class="button button--primary mobile-menu__call" href={phoneHref}>
						<Icon name="phone" size={18} />
						Llamar al {business.phone.display}
					</a>
					<p class="mobile-menu__hours">
						<Icon name="clock" size={16} />
						{business.hours.days}, {business.hours.opens}–{business.hours.closes}
					</p>
				</nav>
			</details>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 50;
	}

	.topbar {
		background: var(--color-ink);
		color: var(--color-bg);
		font-size: 0.78rem;
		line-height: 1.4;
	}

	.topbar__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 0.35rem;
	}

	.topbar__item {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0;
		color: inherit;
	}

	.topbar__item svg {
		flex: none;
		color: var(--color-accent);
	}

	.topbar__phone {
		font-weight: 650;
		text-decoration: none;
	}

	.topbar__phone:hover {
		color: var(--color-accent-soft);
	}

	.header__main {
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: 1px solid var(--color-border);
		background: rgb(255 248 239 / 0.94);
		backdrop-filter: blur(12px);
	}

	.header__inner {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		min-height: 4.75rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		flex: none;
		color: var(--color-ink);
		text-decoration: none;
	}

	.brand:hover .brand__name {
		color: var(--color-brand-dark);
	}

	.brand__copy {
		display: grid;
		gap: 0.05rem;
	}

	.brand__name {
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.1;
		transition: color var(--transition);
	}

	.brand__tagline {
		color: var(--color-ink-muted);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.nav {
		margin-left: auto;
	}

	.nav__list {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nav__link {
		display: block;
		padding: 0.5rem 0.65rem;
		border-radius: 999px;
		color: var(--color-ink-soft);
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color var(--transition),
			color var(--transition);
	}

	.nav__link:hover {
		background: var(--color-brand-soft);
		color: var(--color-brand-dark);
	}

	.nav__link[aria-current='page'] {
		background: var(--color-brand-soft);
		color: var(--color-brand-dark);
	}

	.header__call {
		flex: none;
		padding: 0.65rem 1rem;
		font-size: 0.88rem;
	}

	.mobile-menu {
		position: relative;
		display: none;
		margin-left: auto;
	}

	.mobile-menu__summary {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.55rem 0.85rem;
		border: 1px solid var(--color-border-strong);
		border-radius: 999px;
		background: var(--color-surface);
		color: var(--color-ink);
		font-size: 0.9rem;
		font-weight: 650;
		cursor: pointer;
		list-style: none;
	}

	.mobile-menu__summary::-webkit-details-marker {
		display: none;
	}

	.mobile-menu[open] .mobile-menu__summary {
		border-color: var(--color-brand);
		background: var(--color-brand-soft);
		color: var(--color-brand-dark);
	}

	.mobile-menu__panel {
		position: absolute;
		top: calc(100% + 0.65rem);
		right: 0;
		width: min(20rem, calc(100vw - (var(--gutter) * 2)));
		max-height: calc(100vh - 7rem);
		overflow-y: auto;
		padding: 0.9rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		box-shadow: var(--shadow-md);
	}

	.mobile-menu__list {
		display: grid;
		gap: 0.15rem;
		margin: 0 0 0.75rem;
		padding: 0;
		list-style: none;
	}

	.mobile-menu__link {
		display: block;
		padding: 0.65rem 0.6rem;
		border-radius: 0.6rem;
		color: var(--color-ink);
		font-weight: 600;
		text-decoration: none;
	}

	.mobile-menu__link:hover,
	.mobile-menu__link[aria-current='page'] {
		background: var(--color-brand-soft);
		color: var(--color-brand-dark);
	}

	.mobile-menu__call {
		width: 100%;
	}

	.mobile-menu__hours {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		margin: 0.8rem 0 0;
		color: var(--color-ink-muted);
		font-size: 0.78rem;
		text-align: center;
	}

	.mobile-menu__hours svg {
		flex: none;
	}

	@media (max-width: 1080px) {
		.nav,
		.header__call {
			display: none;
		}

		.mobile-menu {
			display: block;
		}
	}

	@media (max-width: 520px) {
		.topbar__inner {
			justify-content: center;
		}

		.topbar__phone {
			display: none;
		}

		.brand__tagline {
			display: none;
		}

		.header__inner {
			min-height: 4.2rem;
		}
	}

	@media (max-width: 370px) {
		.brand__name {
			font-size: 1.05rem;
		}

		.mobile-menu__summary span {
			display: none;
		}
	}
</style>
