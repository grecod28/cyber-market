---
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import { business, emailHref, fullAddress, phoneHref } from '../data/business';
import { navigation } from '../data/navigation';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="rainbow-rule" aria-hidden="true"></div>
	<div class="container footer__grid">
		<div class="footer__brand">
			<a class="footer__logo" href="/" aria-label={`${business.name}, ir a la página de inicio`}>
				<BrandMark size={42} />
				<span>{business.name}</span>
			</a>
			<p class="footer__description">{business.description}</p>
			<p class="footer__hours">
				<Icon name="clock" size={17} />
				<span>{business.hours.days}, de {business.hours.opens} a {business.hours.closes}</span>
			</p>
		</div>

		<nav class="footer__nav" aria-label="Navegación del pie">
			<h2>Explora</h2>
			<ul>
				{navigation.map((item) => (
					<li><a href={item.href}>{item.label}</a></li>
				))}
			</ul>
		</nav>

		<div class="footer__contact">
			<h2>Contacto</h2>
			<address>
				<p>
					<Icon name="pin" size={17} />
					<a href={business.maps.url} target="_blank" rel="noopener noreferrer">
						{fullAddress}<span class="sr-only"> (se abre en una nueva pestaña)</span>
					</a>
				</p>
				<p>
					<Icon name="phone" size={17} />
					<a href={phoneHref}>{business.phone.display}</a>
				</p>
				<p>
					<Icon name="mail" size={17} />
					<a href={emailHref}>{business.email}</a>
				</p>
			</address>
		</div>
	</div>

	<div class="container footer__bottom">
		<p>© {year} {business.name}. Web informativa; no se realizan ventas online.</p>
		<ul class="footer__legal">
			<li><a href="/aviso-legal/">Aviso legal</a></li>
			<li><a href="/privacidad/">Privacidad y cookies</a></li>
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-deep);
		color: var(--color-bg);
	}

	.footer__grid {
		display: grid;
		gap: 2.25rem;
		padding-block: clamp(2.75rem, 6vw, 4.5rem);
	}

	.footer__brand {
		max-width: 30rem;
	}

	.footer__logo {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		margin-bottom: 1rem;
		color: var(--color-bg);
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 700;
		text-decoration: none;
	}

	.footer__logo:hover {
		color: var(--color-accent-soft);
	}

	.footer__description {
		color: #c7d2e4;
		font-size: 0.92rem;
	}

	.footer__hours {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		margin: 1rem 0 0;
		color: var(--color-accent-soft);
		font-size: 0.88rem;
		font-weight: 600;
	}

	.footer__hours svg {
		flex: none;
		margin-top: 0.15rem;
	}

	.footer__nav h2,
	.footer__contact h2 {
		margin-bottom: 0.9rem;
		color: var(--color-accent-soft);
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.footer__nav ul {
		display: grid;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.footer__nav a,
	.footer__contact a {
		color: #e3e9f4;
		font-size: 0.92rem;
		text-decoration: none;
	}

	.footer__nav a:hover,
	.footer__contact a:hover {
		color: var(--color-accent-soft);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.2em;
	}

	.site-footer :focus-visible {
		outline-color: var(--color-accent-soft);
	}

	.footer__contact address {
		display: grid;
		gap: 0.7rem;
		font-style: normal;
	}

	.footer__contact p {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.55rem;
		align-items: start;
		margin: 0;
	}

	.footer__contact svg {
		flex: none;
		margin-top: 0.15rem;
		color: var(--color-accent);
	}

	.footer__bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 2rem;
		padding-block: 1.25rem;
		border-top: 1px solid rgb(247 248 251 / 0.16);
	}

	.footer__bottom p {
		margin: 0;
		color: #a9b6cd;
		font-size: 0.78rem;
	}

	.footer__legal {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.footer__legal a {
		color: #e3e9f4;
		font-size: 0.78rem;
		text-decoration: none;
	}

	.footer__legal a:hover {
		color: var(--color-accent-soft);
		text-decoration: underline;
	}

	@media (min-width: 760px) {
		.footer__grid {
			grid-template-columns: 1.4fr 0.7fr 1fr;
		}
	}
</style>
