---
import InfoNotice from './InfoNotice.astro';
import type { LegalPage } from '../data/legal';

interface Props {
	page: LegalPage;
	otherHref: string;
	otherLabel: string;
}

const { page, otherHref, otherLabel } = Astro.props;

const slugify = (value: string) =>
	value
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/(^-|-$)/g, '');
---

<div class="container legal-layout">
	<article class="prose legal-article">
		<p class="legal-article__updated">Última actualización: {page.updated}</p>
		<p class="legal-article__intro">{page.intro}</p>

		{page.sections.map((section) => (
			<section aria-labelledby={slugify(section.title)}>
				<h2 id={slugify(section.title)}>{section.title}</h2>
				{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
				{section.items && (
					<ul>
						{section.items.map((item) => <li>{item}</li>)}
					</ul>
				)}
			</section>
		))}
	</article>

	<aside class="legal-aside">
		<InfoNotice title="Plantilla pendiente de revisión" tone="warm" icon="shield">
			<p>
				Este texto es una plantilla informativa. Antes de publicar la web, revísalo y
				completa los datos fiscales, los proveedores y las cookies reales del sitio.
			</p>
		</InfoNotice>

		<nav class="legal-nav" aria-label="Otras páginas legales">
			<a href={otherHref}>{otherLabel}</a>
			<a href="/">Volver al inicio</a>
		</nav>
	</aside>
</div>

<style>
	.legal-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(1.75rem, 5vw, 3.5rem);
		align-items: start;
	}

	.legal-article {
		max-width: 70ch;
	}

	.legal-article__updated {
		margin-bottom: 0.75rem;
		color: var(--color-ink-muted);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.legal-article__intro {
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--color-border);
		color: var(--color-ink-soft);
		font-size: 1.05rem;
	}

	.legal-article section {
		margin-top: 2rem;
	}

	.legal-article h2 {
		margin-bottom: 0.5rem;
		font-size: clamp(1.35rem, 2.5vw, 1.7rem);
	}

	.legal-article p,
	.legal-article li {
		color: var(--color-ink-soft);
	}

	.legal-article ul {
		display: grid;
		gap: 0.35rem;
	}

	.legal-aside {
		display: grid;
		gap: 1rem;
	}

	.legal-nav {
		display: grid;
		gap: 0.55rem;
		padding: 1.1rem 1.2rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
	}

	.legal-nav a {
		color: var(--color-brand-dark);
		font-size: 0.9rem;
		font-weight: 650;
	}

	@media (min-width: 900px) {
		.legal-layout {
			grid-template-columns: minmax(0, 1fr) 18rem;
		}

		.legal-aside {
			position: sticky;
			top: 6rem;
		}
	}
</style>
