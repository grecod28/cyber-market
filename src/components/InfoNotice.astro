---
import Icon from './Icon.astro';
import type { IconName } from '../types/icons';

interface Props {
	title?: string;
	icon?: IconName;
	tone?: 'warm' | 'info' | 'plain';
}

const { title, icon = 'spark', tone = 'warm' } = Astro.props;
---

<aside class:list={['notice', `notice--${tone}`]} role="note">
	<Icon name={icon} size={22} />
	<div>
		{title && <p class="notice__title">{title}</p>}
		<slot />
	</div>
</aside>
