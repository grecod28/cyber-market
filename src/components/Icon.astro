	menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
	fax: '<rect x="6" y="2.5" width="12" height="6" rx="1.5"/><path d="M4 8.5h16v8h-3v4.5H7V16.5H4v-8Z"/><path d="M9 17h6M8 12.5h2"/>',
