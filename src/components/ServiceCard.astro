---
import Icon from './Icon.astro';
import type { Service } from '../data/services';

interface Props {
	service: Service;
}

const { service } = Astro.props;
---

<article class:list={['service-card', `service-card--${service.accent}`]}>
	<span class="service-card__icon">
		<Icon name={service.icon} size={25} />
	</span>
	<h3>{service.title}</h3>
	<p class="service-card__description">{service.description}</p>
	{service.highlights && (
		<ul class="service-card__list">
			{service.highlights.map((highlight) => (
				<li>{highlight}</li>
			))}
		</ul>
	)}
	{service.link && (
		<a class="service-card__link" href={service.link.href}>
			{service.link.label}
			<Icon name="arrowRight" size={16} />
		</a>
	)}
</article>

<style>
	.service-card {
		--card-accent: var(--color-brand);
		--card-accent-soft: var(--color-brand-soft);

		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: clamp(1.25rem, 2.5vw, 1.75rem);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		box-shadow: var(--shadow-sm);
	}

	.service-card--teal {
		--card-accent: var(--color-teal);
		--card-accent-soft: var(--color-teal-soft);
	}

	.service-card--marigold {
		--card-accent: #9a6206;
		--card-accent-soft: var(--color-accent-soft);
	}

	.service-card--magenta {
		--card-accent: var(--color-magenta);
		--card-accent-soft: var(--color-magenta-soft);
	}

	.service-card--green {
		--card-accent: var(--color-green);
		--card-accent-soft: var(--color-green-soft);
	}

	.service-card--coffee {
		--card-accent: var(--color-coffee);
		--card-accent-soft: var(--color-coffee-soft);
	}

	.service-card__icon {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		margin-bottom: 1rem;
		border-radius: 0.9rem;
		background: var(--card-accent-soft);
		color: var(--card-accent);
	}

	.service-card h3 {
		margin-bottom: 0.45rem;
		color: var(--color-ink);
	}

	.service-card__description {
		margin-bottom: 0;
		color: var(--color-ink-soft);
		font-size: 0.94rem;
	}

	.service-card__list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0.9rem 0 0;
		padding: 0;
		list-style: none;
	}

	.service-card__list li {
		padding: 0.2rem 0.55rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-bg);
		color: var(--color-ink-muted);
		font-size: 0.74rem;
		line-height: 1.4;
	}

	.service-card__link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 1rem;
		color: var(--card-accent);
		font-size: 0.88rem;
		font-weight: 650;
		text-decoration: underline;
		text-decoration-color: var(--color-border-strong);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.2em;
	}

	.service-card__link:hover {
		text-decoration-color: currentColor;
	}

	.service-card__link svg {
		transition: transform var(--transition);
	}

	.service-card__link:hover svg {
		transform: translateX(3px);
	}
</style>
