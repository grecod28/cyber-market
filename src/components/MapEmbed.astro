---
import Icon from './Icon.astro';
import { business, fullAddress } from '../data/business';
---

<div class="map-embed">
	<iframe
		src={business.maps.embedUrl}
		title={`Mapa con la ubicación de ${business.name} en ${fullAddress}`}
		loading="lazy"
		referrerpolicy="no-referrer-when-downgrade"
		allowfullscreen
	></iframe>
</div>
<p class="map-embed__link">
	<Icon name="pin" size={16} />
	<a href={business.maps.url} target="_blank" rel="noopener noreferrer">
		Abrir la ubicación en Google Maps<span class="sr-only"> (se abre en una nueva pestaña)</span>
	</a>
</p>
<p class="map-embed__note">
	El mapa se carga desde Google Maps y puede utilizar cookies de terceros. Consulta la
	<a href="/privacidad/">política de privacidad</a>.
</p>

<style>
	.map-embed {
		position: relative;
		overflow: hidden;
		aspect-ratio: 4 / 3;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background: var(--color-surface-alt);
		box-shadow: var(--shadow-sm);
	}

	.map-embed iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.map-embed__link {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0.9rem 0 0;
		font-size: 0.9rem;
		font-weight: 650;
	}

	.map-embed__link svg {
		flex: none;
		color: var(--color-brand);
	}

	.map-embed__note {
		margin: 0.4rem 0 0;
		color: var(--color-ink-muted);
		font-size: 0.74rem;
	}
</style>
