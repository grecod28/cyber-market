---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	eyebrow: string;
	title: string;
	description: string;
	image?: ImageMetadata;
	imageAlt?: string;
	compact?: boolean;
}

const { eyebrow, title, description, image, imageAlt = '', compact = false } = Astro.props;
---

<section class:list={['page-hero', compact && 'page-hero--compact']}>
	<div class:list={['container', 'page-hero__grid', !image && 'page-hero__grid--single']}>
		<div class="page-hero__copy">
			<p class="eyebrow">{eyebrow}</p>
			<h1>{title}</h1>
			<p class="lead">{description}</p>
			<slot name="actions" />
		</div>

		{image && (
			<div class="page-hero__media media-frame">
				<Image src={image} alt={imageAlt} loading="eager" decoding="async" />
			</div>
		)}
	</div>
</section>

<style>
	.page-hero {
		position: relative;
		overflow: hidden;
		padding-block: clamp(2.5rem, 6vw, 4.5rem);
		background:
			radial-gradient(circle at 90% 10%, rgb(240 178 63 / 0.2), transparent 24rem),
			linear-gradient(180deg, rgb(234 238 247 / 0.7), transparent 80%);
	}

	.page-hero__grid {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 3.5rem);
		align-items: center;
	}

	.page-hero__copy h1 {
		max-width: 17ch;
		margin-bottom: 0.4em;
	}

	.page-hero--compact {
		padding-block: clamp(2rem, 4vw, 3rem);
	}

	.page-hero--compact .page-hero__copy h1 {
		font-size: clamp(2rem, 4vw, 3.1rem);
	}

	.page-hero__media {
		width: 100%;
	}

	.page-hero__media img {
		width: 100%;
		height: auto;
	}

	@media (min-width: 880px) {
		.page-hero__grid {
			grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		}

		.page-hero__grid--single {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
