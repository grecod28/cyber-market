---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import HeroIllustration from '../assets/illustrations/hero-cyber-market.svg';
import MoneyIllustration from '../assets/illustrations/envio-dinero.svg';
import CategoryCard from '../components/CategoryCard.astro';
import ContactCta from '../components/ContactCta.astro';
import Icon from '../components/Icon.astro';
import ScheduleBlock from '../components/ScheduleBlock.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { business, emailHref, fullAddress, phoneHref } from '../data/business';
import { categories } from '../data/categories';
import { moneyTransfer } from '../data/moneyTransfer';
import { seo } from '../data/seo';
import { featuredServices } from '../data/services';
---

<Layout title={seo.pages.home.title} description={seo.pages.home.description}>
	<section class="hero">
		<div class="container hero__grid">
			<div class="hero__copy">
				<p class="eyebrow">Ciber-locutorio y tienda de barrio · Vigo</p>
				<h1>
					Tu ciber y tu tienda de barrio,{' '}
					<span class="hero__accent">abiertos todos los días</span>
				</h1>
				<p class="lead">
					Internet, locutorio, envío de dinero, paquetería, reparaciones y productos
					latinoamericanos en pleno centro de Vigo. De 10:00 a 01:00, también festivos.
				</p>

				<ContactCta />

				<ul class="hero__points" aria-label="Servicios destacados">
					<li><Icon name="check" size={16} /> Envío de dinero con Ria y Transfast</li>
					<li><Icon name="check" size={16} /> Punto de paquetería</li>
					<li><Icon name="check" size={16} /> Productos latinoamericanos</li>
				</ul>
			</div>

			<div class="hero__media">
				<div class="hero__frame">
					<Image
						src={HeroIllustration}
						alt="Ilustración de la fachada de Cyber Market, con toldo a rayas, escaparate iluminado y cartel de la tienda."
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
				</div>
				<div class="hero__badge">
					<span class="hero__badge-icon"><Icon name="clock" size={20} /></span>
					<span>
						<strong>10:00 – 01:00</strong>
						<small>Todos los días y festivos</small>
					</span>
				</div>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="servicios">
		<div class="container">
			<div class="section-top">
				<SectionHeading
					id="servicios"
					eyebrow="Servicios"
					title="Todo lo que necesitas, cerca de casa"
					description="Gestiones de cada día, paquetes, reparaciones y ese antojo latinoamericano que te apetece."
				/>
				<a class="text-link" href="/servicios/">
					Ver todos los servicios
					<Icon name="arrowRight" size={17} />
				</a>
			</div>

			<div class="card-grid card-grid--services">
				{featuredServices.map((service) => <ServiceCard service={service} />)}
			</div>
		</div>
	</section>

	<section class="section section--alt" aria-labelledby="productos">
		<div class="container">
			<div class="section-top">
				<SectionHeading
					id="productos"
					eyebrow="Despensa latinoamericana"
					title="Un trocito de casa, en Vigo"
					description="Harinas, snacks, bebidas, salsas, panadería, café y mate. Una selección pensada para que encuentres ese sabor de siempre sin ir muy lejos."
				/>
				<a class="text-link" href="/productos-latinos/">
					Ver productos latinoamericanos
					<Icon name="arrowRight" size={17} />
				</a>
			</div>

			<div class="card-grid card-grid--categories">
				{categories.map((category) => <CategoryCard category={category} compact />)}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="dinero">
		<div class="container split split--wide">
			<div class="media-frame money-media">
				<Image
					src={MoneyIllustration}
					alt="Ilustración de un sobre con una ruta de puntos hacia un destino, junto a un globo terráqueo y un avión de papel."
					loading="lazy"
					decoding="async"
				/>
			</div>

			<div>
				<p class="eyebrow">{moneyTransfer.eyebrow}</p>
				<h2 id="dinero">{moneyTransfer.title}</h2>
				<p class="lead">
					Somos punto de servicio de Ria y Transfast en Vigo. Ven a la tienda y te
					ayudamos con el envío de forma presencial, explicándote qué necesitas.
				</p>
				<ul class="check-list money-list">
					<li><Icon name="check" size={18} /> Atención presencial, en español</li>
					<li><Icon name="check" size={18} /> Te indicamos la documentación necesaria</li>
					<li><Icon name="check" size={18} /> Consulta destinos y condiciones en tienda</li>
				</ul>
				<div class="cta-row">
					<a class="button button--primary" href="/envio-de-dinero/">Cómo enviar dinero</a>
					<a class="text-link" href={phoneHref}>
						<Icon name="phone" size={17} />
						Llamar al {business.phone.display}
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="section section--alt" aria-labelledby="horario">
		<div class="container">
			<div class="schedule-panel">
				<div class="schedule-panel__copy">
					<p class="eyebrow">Horario</p>
					<h2 id="horario">Abiertos cuando lo necesitas</h2>
					<p class="lead">
						De lunes a domingo y festivos, de 10:00 a 01:00. Si tienes una gestión
						urgente, llámanos antes y te confirmamos que podemos atenderte.
					</p>
					<ContactCta showEmail />
				</div>
				<ScheduleBlock />
			</div>
		</div>
	</section>

	<section class="section section--dark" aria-labelledby="visitanos">
		<div class="container final-cta">
			<div class="final-cta__copy">
				<p class="eyebrow">Te esperamos</p>
				<h2 id="visitanos">Pásate por Cyber Market</h2>
				<p class="lead">
					Estamos en Avda. García Barbón, 102, en el centro de Vigo. Ven a vernos o
					llámanos y te ayudamos con lo que necesites.
				</p>
				<ContactCta light />
			</div>

			<div class="final-cta__info">
				<p>
					<Icon name="pin" size={19} />
					<a href={business.maps.url} target="_blank" rel="noopener noreferrer">
						{fullAddress}<span class="sr-only"> (se abre en una nueva pestaña)</span>
					</a>
				</p>
				<p>
					<Icon name="phone" size={19} />
					<a href={phoneHref}>{business.phone.display}</a>
				</p>
				<p>
					<Icon name="clock" size={19} />
					<span>{business.hours.days}, de {business.hours.opens} a {business.hours.closes}</span>
				</p>
				<p>
					<Icon name="mail" size={19} />
					<a href={emailHref}>{business.email}</a>
				</p>
			</div>
		</div>
	</section>
</Layout>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 5.5rem);
	}

	.hero::before {
		position: absolute;
		top: -12rem;
		right: -10rem;
		width: 34rem;
		height: 34rem;
		border-radius: 50%;
		background: radial-gradient(circle, rgb(227 154 23 / 0.2), transparent 68%);
		content: '';
		pointer-events: none;
	}

	.hero__grid {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2.5rem;
		align-items: center;
	}

	.hero__copy h1 {
		max-width: 15ch;
		margin-bottom: 0.4em;
	}

	.hero__accent {
		display: inline;
		color: var(--color-brand);
		background-image: linear-gradient(transparent 76%, var(--color-accent-soft) 76%);
		background-repeat: no-repeat;
	}

	.hero__points {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.15rem;
		margin: 1.5rem 0 0;
		padding: 0;
		color: var(--color-ink-soft);
		font-size: 0.86rem;
		list-style: none;
	}

	.hero__points li {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.hero__points svg {
		flex: none;
		color: var(--color-teal);
	}

	.hero__media {
		position: relative;
		min-width: 0;
	}

	.hero__frame {
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: 2.5rem 2.5rem 2.5rem 0.9rem;
		background: var(--color-surface-alt);
		box-shadow: var(--shadow-md);
	}

	.hero__frame img {
		width: 100%;
		height: auto;
	}

	.hero__badge {
		position: absolute;
		bottom: 1rem;
		left: 1rem;
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.65rem 0.9rem;
		border: 1px solid var(--color-border);
		border-radius: 0.9rem;
		background: rgb(255 253 249 / 0.96);
		box-shadow: var(--shadow-sm);
	}

	.hero__badge-icon {
		display: grid;
		place-items: center;
		width: 2.4rem;
		height: 2.4rem;
		border-radius: 0.7rem;
		background: var(--color-teal-soft);
		color: var(--color-teal-dark);
	}

	.hero__badge strong,
	.hero__badge small {
		display: block;
		line-height: 1.25;
	}

	.hero__badge strong {
		color: var(--color-brand-dark);
		font-family: var(--font-display);
		font-size: 1.1rem;
	}

	.hero__badge small {
		color: var(--color-ink-muted);
		font-size: 0.7rem;
	}

	.card-grid--services {
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
	}

	.card-grid--categories {
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
	}

	.money-media img {
		width: 100%;
		height: auto;
	}

	.money-list {
		margin-top: 1.35rem;
		color: var(--color-ink-soft);
		font-size: 0.92rem;
	}

	.schedule-panel {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: center;
		padding: clamp(1.5rem, 4vw, 3rem);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background:
			radial-gradient(circle at 96% 6%, rgb(227 154 23 / 0.16), transparent 18rem),
			var(--color-surface);
		box-shadow: var(--shadow-sm);
	}

	.schedule-panel__copy h2 {
		margin-bottom: 0.4em;
	}

	.final-cta {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}

	.final-cta__copy h2 {
		margin-bottom: 0.4em;
	}

	.final-cta__info {
		display: grid;
		gap: 0.9rem;
		padding: clamp(1.25rem, 3vw, 1.75rem);
		border: 1px solid rgb(255 248 239 / 0.18);
		border-radius: var(--radius-lg);
		background: rgb(255 248 239 / 0.05);
	}

	.final-cta__info p {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.65rem;
		align-items: start;
		margin: 0;
		color: #f1ddc9;
		font-size: 0.92rem;
	}

	.final-cta__info svg {
		flex: none;
		margin-top: 0.15rem;
		color: var(--color-accent);
	}

	.final-cta__info a {
		color: var(--color-bg);
	}

	@media (min-width: 760px) {
		.schedule-panel {
			grid-template-columns: 1.2fr 0.8fr;
		}

		.final-cta {
			grid-template-columns: 1.1fr 0.9fr;
		}
	}

	@media (min-width: 960px) {
		.hero__grid {
			grid-template-columns: 1.02fr 0.98fr;
		}
	}
</style>
